{
  "appId": "com.netcha.app",
  "appName": "Netcha",
  "webDir": "www",
  "android": {
    "allowMixedContent": false
  },
  "plugins": {
    "CapacitorSQLite": {
      "androidIsEncryption": true,
      "iosIsEncryption": true
    },
    "LocalNotifications": {
      "iconColor": "#8b9cff",
      "sound": null
    },
    "FirebaseMessaging": {
      "presentationOptions": [
        "badge",
        "sound",
        "alert"
      ]
    },
    "SecureStorage": {}
  },
  "server": {
    "url": "https://gentle-tranquility-production-db0a.up.railway.app",
    "cleartext": false,
    "allowNavigation": [
      "gentle-tranquility-production-db0a.up.railway.app"
    ]
  }
}
